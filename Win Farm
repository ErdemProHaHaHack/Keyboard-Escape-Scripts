-- Variables
local character = Player.Character or Player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")
local isFarming = false
local savedPosition = rootPart.Position
local farmThread = nil

-- Update character reference on respawn (Fixes the "breaking on death" issue)
Player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart = newChar:WaitForChild("HumanoidRootPart")
end)

-- Search for reward parts
local function findReward()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("reward") or name:find("bonus") or name:find("chest") or 
               name:find("win") or name:find("prize") or name:find("collect") or name:find("250k") then
                return obj
            end
        end
    end
    return nil
end

-- Teleport Logic
local function teleportToReward()
    local target = findReward()
    if target then
        rootPart.CFrame = CFrame.new(target.Position + Vector3.new(0, 2, 0))
        return true
    end
    return false
end

local function teleportBack()
    rootPart.CFrame = CFrame.new(savedPosition)
end

