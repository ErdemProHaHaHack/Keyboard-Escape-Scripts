    KeyFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    KeyFrame.Parent = KeyGui
    Instance.new("UICorner", KeyFrame)

    local KeyTitle = Instance.new("TextLabel")
    KeyTitle.Size = UDim2.new(1, 0, 0, 40)
    KeyTitle.Text = "ENTER KEY"
    KeyTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    KeyTitle.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    KeyTitle.Parent = KeyFrame
    Instance.new("UICorner", KeyTitle)

    local KeyInput = Instance.new("TextBox")
    KeyInput.Size = UDim2.new(0, 200, 0, 40)
    KeyInput.Position = UDim2.new(0.5, -100, 0, 50)
    KeyInput.PlaceholderText = "Key here..."
    KeyInput.Text = ""
    KeyInput.Parent = KeyFrame
    Instance.new("UICorner", KeyInput)

    local KeyBtn = Instance.new("TextButton")
    KeyBtn.Size = UDim2.new(0, 100, 0, 35)
    KeyBtn.Position = UDim2.new(0.5, -50, 0, 100)
    KeyBtn.Text = "Verify"
    KeyBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    KeyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    KeyBtn.Parent = KeyFrame
    Instance.new("UICorner", KeyBtn)

    KeyBtn.MouseButton1Click:Connect(function()
        if KeyInput.Text == key_required then
            if writefile then writefile("farm script key.txt", "Key: " .. key_required) end
            KeyGui:Destroy()
            callback()
        else
            KeyInput.Text = ""
            KeyInput.PlaceholderText = "WRONG KEY!"
        end
    end)
end

