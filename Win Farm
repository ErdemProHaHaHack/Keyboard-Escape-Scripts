-- [KEY SİSTEMİ]
local function checkKey()
    if readfile then
        local success, content = pcall(function() return readfile("farm script key.txt") end)
        if success and content == "Key: " .. key_required then
            return true
        end
    end
    return false
end

local function ShowKeySystem(callback)
    local KeyGui = Instance.new("ScreenGui")
    KeyGui.Name = "KeySystem"
    KeyGui.Parent = v0:WaitForChild("PlayerGui")
    
    local KeyFrame = Instance.new("Frame")
    KeyFrame.Size = UDim2.new(0, 300, 0, 150)
