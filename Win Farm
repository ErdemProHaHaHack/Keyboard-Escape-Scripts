-- Logic Functions
local function stopFarm()
    isFarming = false
    if farmThread then 
        task.cancel(farmThread) 
        farmThread = nil 
    end
    ToggleBtn.Text = "START"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 100)
    StatusLabel.Text = "Status: Stopped"
    StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    print("Farm Stopped.")
end

local function startFarm()
    if isFarming then return end
    isFarming = true
    savedPosition = rootPart.Position
    
    ToggleBtn.Text = "STOP"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    StatusLabel.Text = "Status: Farming..."
    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
    print("Farm Started.")
    
    farmThread = task.spawn(function()
        while isFarming do
            if teleportToReward() then
                task.wait(0.5) -- Wait at reward
            end
            teleportBack()
            task.wait(1) -- Wait before next search
        end
    end)
end

-- Button Event
ToggleBtn.MouseButton1Click:Connect(function()
    if isFarming then
        stopFarm()
    else
        startFarm()
    end
end)

-- Hotkeys
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.F6 then
        MainFrame.Visible = not MainFrame.Visible
    elseif input.KeyCode == Enum.KeyCode.F4 then
        if isFarming then stopFarm() else startFarm() end
    end
end)

print("Modern Reward Farm Loaded Successfully!")
